DATABASE_URL=postgresql://postgres:postgres@localhost:5432/subastas
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
JWT_REFRESH_EXPIRES_IN=7d
PORT=3000
FRONTEND_URL=http://localhost:5173
# Optional: override the Expo Go deep link used in approval emails.
# For a phone on the same Wi-Fi, use your machine's LAN IP, for example:
# MOBILE_COMPLETE_REGISTRATION_URL=exp://10.0.200.22:8081/--/register-credentials
MOBILE_COMPLETE_REGISTRATION_URL=
UPLOAD_DIR=./uploads
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@subastas.com
NODE_ENV=development
